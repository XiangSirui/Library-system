<view class="page">
  <view class="eyebrow">YOUR READING & GARDEN DAYS</view><view class="title">我的记录</view>
  <view class="muted">借阅、读后感与相聚时光，都在这里。</view>
  <view class="card section">
    <block wx:if="{{!user}}">
      <view class="subtitle">微信登录，查看我的记录</view>
      <view class="muted">借阅、预约和读后感只向所属微信账户展示。</view>
      <checkbox-group bindchange="consent"><label class="check"><checkbox value="yes" checked="{{accepted}}" disabled="{{busy}}" /><view>已阅读隐私说明，同意使用微信身份识别我的服务记录。</view></label></checkbox-group>
      <button class="primary" bindtap="login" disabled="{{busy}}" loading="{{busy}}">微信登录</button>
    </block>
    <block wx:else>
      <view class="row"><view class="subtitle">已登录</view><button class="small ghost" bindtap="logout" disabled="{{busy}}">退出登录</button></view>
      <view class="hint">账户编号（核验旧记录时向管理员出示）</view><text class="code" selectable>{{user.id}}</text>
      <view class="hint">以前的手机号记录需到馆核验并绑定，无法通过输入手机号认领。</view>
    </block>
    <view class="hint"><text class="link" bindtap="privacy">阅读隐私说明</text></view>
  </view>
  <view wx:if="{{user}}" class="card section">
    <view class="label">按手机号查本人记录</view>
    <view class="query-row"><input value="{{phone}}" bindinput="phoneInput" type="number" maxlength="11" placeholder="留空查看全部本人记录" bindconfirm="load" disabled="{{busy}}" /><button class="primary" bindtap="load" disabled="{{busy || loading}}">查询</button></view>
    <view class="hint">仅在当前微信账户已绑定的记录内查询。</view>
  </view>
  <view class="tabs">
    <button class="{{kind === 'borrows' ? 'active' : ''}}" data-kind="borrows" bindtap="kindTap" disabled="{{busy}}">图书借阅</button>
    <button class="{{kind === 'rooms' ? 'active' : ''}}" data-kind="rooms" bindtap="kindTap" disabled="{{busy}}">活动室预约</button>
    <button class="{{kind === 'reviews' ? 'active' : ''}}" data-kind="reviews" bindtap="kindTap" disabled="{{busy}}">我的读后感</button>
  </view>
  <view wx:if="{{kind !== 'reviews'}}" class="tabs subtabs">
    <button class="{{period === 'active' ? 'active' : ''}}" data-period="active" bindtap="periodTap" disabled="{{busy}}">{{kind === 'borrows' ? '借阅中' : '当前预约'}}</button>
    <button class="{{period === 'history' ? 'active' : ''}}" data-period="history" bindtap="periodTap" disabled="{{busy}}">历史记录</button>
  </view>
  <view wx:if="{{!queried}}" class="empty">微信登录后即可查看你的记录。</view>
  <view wx:elif="{{loading}}" class="notice">正在查询记录…</view>
  <view wx:elif="{{error}}" class="notice error">{{error}}<button class="small ghost" bindtap="load">重新加载</button></view>
  <view wx:elif="{{!records.length}}" class="empty">这里还没有记录。</view>
  <view wx:if="{{access}}" id="doorAccess" class="card section">
    <view class="row"><view class="subtitle">活动室门锁密码</view><button class="small ghost" bindtap="closeAccess">隐藏</button></view>
    <view class="muted">{{access.date}} {{access.timeSlot}} 的预约</view>
    <text class="door-code" selectable>{{access.password}}</text>
    <view class="hint">仅供本次预约使用，请按预约时段进入。预约结束后密码将隐藏，请勿转发。</view>
  </view>
  <view class="grid">
    <view wx:for="{{records}}" wx:key="id" class="card record">
      <view class="row"><text class="badge {{item.overdue ? 'overdue' : ''}}">{{item.statusLabel}}</text><text wx:if="{{item.code}}" class="code">{{item.code}}</text></view>
      <block wx:if="{{kind === 'borrows'}}">
        <view class="record-title record-heading">{{item.bookTitle}}</view><view class="muted">{{item.author}}</view>
        <view class="record-line">借阅日期：{{item.borrowDate}}</view><view class="record-line">应还日期：{{item.dueDate}}</view>
        <view wx:if="{{item.returnDate}}" class="record-line">归还日期：{{item.returnDate}}</view>
        <view wx:if="{{item.renewed}}" class="hint">已续借一次</view>
        <view class="actions">
          <button wx:if="{{item.status === 'borrowed'}}" class="small primary" data-id="{{item.id}}" data-action="return" bindtap="action" disabled="{{busy || loading}}">归还登记</button>
          <button wx:if="{{item.status === 'borrowed' && !item.renewed}}" class="small" data-id="{{item.id}}" data-action="renew" bindtap="action" disabled="{{busy || loading}}">续借 30 天</button>
          <button class="small ghost" data-book-id="{{item.bookId}}" bindtap="review" disabled="{{busy || loading}}">写读后感</button>
          <button class="small ghost" data-book-id="{{item.bookId}}" bindtap="book" disabled="{{busy}}">图书详情</button>
        </view>
      </block>
      <block wx:elif="{{kind === 'rooms'}}">
        <view class="record-title record-heading">{{item.purpose}}</view>
        <view class="record-line">{{item.date}}　{{item.timeSlot}} · {{item.duration}} 小时</view><view class="record-line">{{item.attendees}} 人 · {{item.name}}</view>
        <view wx:if="{{item.status === 'upcoming' && !item.canCheckout}}" class="hint">活动开始后可提交志愿服务材料签退。</view>
        <view wx:if="{{item.canCheckout}}" class="hint">待提交志愿服务材料完成签退。</view>
        <view wx:if="{{item.volunteerNote}}" class="notice body-text">{{item.volunteerNote}}</view>
        <button wx:if="{{item.volunteerImage}}" class="small ghost" data-path="{{item.volunteerImage}}" bindtap="preview" disabled="{{busy}}">查看志愿照片</button>
        <view class="actions">
          <button wx:if="{{item.canAccess}}" class="small primary" data-id="{{item.id}}" bindtap="showAccess" disabled="{{busy || loading}}">查看门锁密码</button>
          <button wx:if="{{item.canCheckout}}" class="small primary" data-id="{{item.id}}" bindtap="checkout" disabled="{{busy || loading}}">提交材料 / 签退</button>
          <button wx:if="{{item.canCancel}}" class="small danger" data-id="{{item.id}}" data-action="cancel" bindtap="action" disabled="{{busy || loading}}">取消预约</button>
        </view>
      </block>
      <block wx:else>
        <view class="record-title record-heading">{{item.bookTitle}}</view>
        <view class="rating">评分 {{item.rating}} / 5</view><view class="body-text">{{item.content}}</view>
        <view wx:if="{{item.rejectReason}}" class="notice error">修改建议：{{item.rejectReason}}</view>
        <view class="hint">{{item.updatedAt}}</view>
        <view class="actions">
          <button class="small" data-id="{{item.id}}" data-book-id="{{item.bookId}}" bindtap="review" disabled="{{busy || loading}}">编辑读后感</button>
          <button class="small danger" data-id="{{item.id}}" data-action="delete" bindtap="action" disabled="{{busy || loading}}">删除</button>
          <button class="small ghost" data-book-id="{{item.bookId}}" bindtap="book" disabled="{{busy}}">图书详情</button>
        </view>
      </block>
    </view>
  </view>
  <view class="section card">
    <view class="subtitle">个人信息与管理</view>
    <view class="actions"><button class="small ghost" bindtap="privacy">隐私说明</button><button class="small ghost" bindtap="clearLocal" disabled="{{busy}}">清空本机信息</button><button class="small ghost" bindtap="admin">管理员入口</button></view>
  </view>
</view>
