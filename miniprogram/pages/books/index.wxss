.search { margin: 24px 0 0; } .search input { flex: 1; min-width: 0; } .search button { flex-shrink: 0; }
.book-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.book-card { padding: 12px; display: flex; flex-direction: column; } .book-card .cover { flex: 1; }
.book-meta { margin: 14px 0; } .book-meta .record-title { font-size: 16px; }
.availability { font-size: 12px; color: #61784e; margin-top: 6px; } .book-card button { font-size: 12px; padding: 12px 4px; }
.cover-title { font-size: 20px; } .cover { padding: 14px 10px; min-height: 180px; }
@media (min-width: 700px) { .book-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; } .book-card { padding: 20px; } .cover { min-height: 220px; } .cover-title { font-size: 26px; } }
@media (min-width: 1100px) { .book-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
