<view class="page">
  <view class="hero">
    <image wx:if="{{hero}}" class="hero-image" src="{{hero}}" mode="aspectFill" binderror="imageError" />
    <view class="hero-shade"></view>
    <view class="hero-content">
      <view class="eyebrow">QINGLIN DUIYUE · COMMUNITY GARDEN</view>
      <view class="hero-title">一座由居民<text>共同创造</text>的花园</view>
      <view class="hero-lead">让自然、阅读与邻里交流，在这里发生。</view>
      <view class="actions"><button class="primary" bindtap="books">去借一本书</button><button bindtap="room">预约花园小屋</button></view>
      <view class="hero-note">共商　/　共建　/　共治　/　共享</view>
    </view>
  </view>
  <view class="notice" wx:if="{{error}}">{{error}}<view class="actions"><button class="small ghost" bindtap="retryPhotos">重新加载照片</button></view></view>
  <view class="tabs">
    <button bindtap="scroll" data-target="about">花园概览</button><button bindtap="scroll" data-target="map">平面导览</button><button bindtap="scroll" data-target="story">共建故事</button><button bindtap="scroll" data-target="nature">花园生命</button>
  </view>
  <view class="section" id="map">
    <view class="eyebrow">GARDEN GUIDE</view><view class="subtitle">一张图，读懂花园</view>
    <view class="muted">点击平面图可放大查看，双指缩放或用鼠标查看细节。</view>
    <image wx:if="{{map}}" class="map-image photo" src="{{map}}" mode="widthFix" data-url="{{map}}" bindtap="preview" binderror="imageError" />
    <view class="wrap"><text wx:for="{{places}}" wx:key="*this" class="badge">{{item}}</text></view>
  </view>
  <view wx:for="{{sections}}" wx:key="id" wx:for-item="section" class="section" id="{{section.id}}">
    <view class="eyebrow">{{section.eyebrow}}</view><view class="subtitle">{{section.title}}</view><view class="section-intro">{{section.description}}</view>
    <view class="grid three">
      <view wx:for="{{section.photos}}" wx:key="path" class="photo-card" data-url="{{item.url}}" bindtap="preview">
        <image wx:if="{{item.url}}" src="{{item.url}}" class="gallery-image" mode="aspectFill" lazy-load binderror="imageError" />
        <view class="caption">{{item.caption}}</view>
      </view>
    </view>
  </view>
  <view class="section card join">
    <view class="eyebrow">GROW WITH US</view><view class="subtitle">花园的下一段故事，等你一起来写</view>
    <view>从共议、清理、搭建、种植到共治，每一次浇水、除草、分享和陪伴，都会让这座共同的花园继续生长。</view>
    <view class="actions"><button class="primary" bindtap="room">预约活动室</button><button class="ghost" bindtap="books">走进图书馆</button></view>
  </view>
  <view class="footer">青邻兑悦 · 花园小屋<view>周一至周日 08:00—20:00</view><view>图书借阅 · 活动预约 · 花园共建</view></view>
</view>