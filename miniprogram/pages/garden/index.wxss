.hero { position: relative; background: #334d38; border-radius: 24px; overflow: hidden; min-height: 440px; color: #fffefa; }
.hero-image, .hero-shade { position: absolute; width: 100%; height: 100%; top: 0; left: 0; }
.hero-shade { background: linear-gradient(90deg, rgba(23,47,27,.86), rgba(23,47,27,.22)); }
.hero-content { position: relative; padding: 36px 24px; max-width: 560px; }
.hero .eyebrow { color: #d4e0be; font-size: 10px; letter-spacing: 2px; }
.hero-title { font-family: Georgia, 'Songti SC', serif; font-size: 36px; font-weight: 600; line-height: 1.45; margin: 26px 0 14px; }
.hero-title text { display: block; color: #dce8be; }
.hero-lead { font-size: 14px; opacity: .9; }
.hero-note { font-size: 11px; letter-spacing: 2px; margin-top: 32px; opacity: .7; }
.map-image { margin: 18px 0; }
.section-intro { margin: 0 0 20px; color: #606c5c; max-width: 760px; }
.gallery-image { width: 100%; height: 220px; display: block; background: #e3e8da; }
.photo-card { border-radius: 16px; overflow: hidden; background: #fffefa; }
.caption { padding: 14px 16px; font-size: 13px; }
.join { background: #e9eddf; }
.footer { text-align: center; margin-top: 40px; color: #606c5c; font-size: 12px; }
@media (min-width: 700px) { .hero-content { padding: 50px; } .hero-title { font-size: 48px; } .hero { min-height: 500px; } .section { margin-top: 48px; } }
