page { background: #f6f4ed; color: #263d30; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 15px; line-height: 1.65; }
view, scroll-view, input, textarea, button { box-sizing: border-box; }
button { font-size: 15px; line-height: 1.5; margin: 0; border-radius: 12px; padding: 12px 18px; color: #315e46; background: #e8ede4; min-height: 46px; }
button::after { border: 0; }
button[disabled] { opacity: .48; }
button.primary { background: #315e46; color: #fffefa; }
button.danger { background: #f5e5df; color: #983f2e; }
button.ghost { background: transparent; border: 1px solid #d5dccf; }
button.small { padding: 9px 14px; font-size: 13px; min-height: 40px; }
.page { width: 100%; max-width: 1200px; margin: 0 auto; padding: 24px 16px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
.eyebrow { font-size: 11px; letter-spacing: 3px; color: #7c886f; margin-bottom: 8px; }
.title { font-family: Georgia, 'Songti SC', serif; font-size: 32px; font-weight: 600; line-height: 1.3; margin-bottom: 10px; }
.subtitle { font-size: 22px; font-weight: 600; line-height: 1.4; margin-bottom: 12px; }
.muted, .hint { color: #788071; font-size: 13px; }
.hint { margin: 8px 0; }
.section { margin-top: 30px; }
.card { background: #fffefa; border: 1px solid #e2e5d9; border-radius: 18px; padding: 20px; overflow: hidden; }
.stack > view, .stack > form { margin-bottom: 16px; }
.grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
.grid > view, .split > view, .split > form { min-width: 0; }
.split { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; align-items: start; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.wrap { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
.actions > button { flex-grow: 1; }
.badge { display: inline-block; background: #e8ede4; color: #476342; border-radius: 6px; padding: 3px 9px; font-size: 11px; }
.field { margin: 14px 0; }
.label { display: block; font-size: 13px; margin-bottom: 6px; font-weight: 600; }
input, textarea, .picker { width: 100%; border: 1px solid #dce1d3; border-radius: 10px; background: #fffefa; padding: 12px; color: #263d30; }
input { height: 48px; }
textarea { height: 160px; }
.check { display: flex; align-items: flex-start; font-size: 12px; color: #727b70; margin: 16px 0; }
checkbox { transform: scale(.8); transform-origin: left center; }
.link { color: #315e46; text-decoration: underline; }
.notice { padding: 14px 16px; border-radius: 12px; background: #eceee2; font-size: 13px; margin: 16px 0; }
.error { background: #f7e9e2; color: #8b4832; }
.empty { padding: 36px 18px; text-align: center; color: #788071; }
.tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0; }
.tabs button { padding: 10px 15px; font-size: 13px; }
.tabs .active { color: #fffefa; background: #315e46; }
.photo { width: 100%; display: block; border-radius: 12px; background: #e8ede4; }
.record-title { font-size: 18px; font-weight: 600; margin-bottom: 8px; }
.body-text { white-space: pre-wrap; word-break: break-word; }
.record { margin-bottom: 16px; }
.code { font-family: monospace; letter-spacing: 1px; }
.cover { min-height: 170px; background: #dce4d0; border-radius: 6px 14px 14px 6px; border-left: 8px solid #aebd9c; padding: 22px 16px; display: flex; flex-direction: column; justify-content: space-between; }
.cover-title { font-family: Georgia, 'Songti SC', serif; font-size: 23px; line-height: 1.45; font-weight: 600; }
@media (min-width: 700px) { .page { padding: 36px 28px; } .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .split { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 28px; } .title { font-size: 40px; } }
@media (min-width: 1100px) { .page { padding: 48px 32px; } .grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
