# Copy to app.env, fill on the server, chmod 600. Never commit actual secrets.
SECRET_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Fernet key, generated once; back up securely separately from data snapshots.
DOOR_CODE_KEY=
PUBLIC_BASE_URL=https://garden.example.com
# Required on first database initialization; at least 12 characters.
INITIAL_ADMIN_PASSWORD=
FLASK_DEBUG=0
